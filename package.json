{
  "name": "@comchatx/cx-schedule",
  "version": "0.3.4",
  "description": "Lets cx do things for you at the times you set.",
  "license": "MIT",
  "author": "ComChatX",
  "comchatx": {
    "name": "Scheduled Tasks",
    "about": "让 cx 在你设定的时间替你做事。",
    "mark": {
      "line": "clock"
    },
    "section": "extensions",
    "order": 30,
    "builds": [
      "@amaster.ai/pi-task-scheduler"
    ],
    "awake": true,
    "settings": {
      "pi-scheduler": {
        "dataDir": "{tree}/.pi/pi-scheduler"
      }
    }
  },
  "homepage": "https://github.com/comchatx/cx-schedule#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-schedule.git"
  },
  "bugs": "https://github.com/comchatx/cx-schedule/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "skills",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-telemetry": "1.3.0"
  }
}
